# =====================================================================
# LOCAL OLLAMA & GEMMA 4 CONFIGURATION
# =====================================================================
# Local Ollama base URL
OLLAMA_BASE_URL="http://localhost:11434"

# Gemma 4 Local Model Tag in Ollama:
# - gemma4          (Default Gemma 4 model)
# - gemma4:e4b      (Lightweight 4B edge model for laptops/consumer GPUs)
# - gemma4:26b      (MoE 26B-A4B model - 4B active parameters)
# - gemma4:31b      (Full 31B flagship dense model)
OLLAMA_MODEL="gemma4"

# Optional delay (in seconds) between agent runs
AGENT_COOLDOWN_SECONDS="1"



# =====================================================================
# OPENROUTER CONFIGURATION
# =====================================================================
OPENROUTER_API_KEY="sk-or-v1-your-api-key-here"

# Option 1: Gemma 4 (4B Active Parameters MoE - Free Tier)
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"

# Option 2: Gemma 4 (4B Active Parameters MoE - Paid/High-Speed Tier)
# OPENROUTER_MODEL="google/gemma-4-26b-a4b-it"

# Option 3: Dense 4B Model (Gemma 3 4B - Free Tier)
# OPENROUTER_MODEL="google/gemma-3-4b-it:free"

APP_SITE_URL="http://localhost:3000"
APP_TITLE="Open-Source Creator Studio"



